# StoreOrSell Backend Environment Variables
# Copy this file to .env and fill in the values

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (safe for demo apps with public RLS policies)
# For production with authentication, use SUPABASE_SERVICE_ROLE_KEY instead
SUPABASE_ANON_KEY=your-anon-key-here

# Backend server port
PORT=3001
